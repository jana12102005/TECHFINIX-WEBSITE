# Copy this file to .env for local development.
# Never commit the real .env — on Render, set these as dashboard env vars instead.

SECRET_KEY=change-this-to-a-long-random-string

# MongoDB Atlas connection string. Leave blank locally to auto-fall-back
# to an in-memory mongomock database (data resets every restart — fine
# for UI development, NOT for real participant data).
MONGODB_URI=
MONGODB_DB=techfinix26

# Cloudinary (leave all three blank to use local disk storage for dev)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# First super coordinator, auto-created if no coordinator exists yet.
# Change the password immediately after first login.
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=techfinix26

FLASK_DEBUG=1
PORT=5000
